# Copy to .env. This DATABASE_URL is the local database from compose.yaml
# (`docker compose up -d`); point it elsewhere to use another one.
DATABASE_URL=postgres://chocobo:chocobo@localhost:5434/chocobo_race
# Port the server listens on (optional, 3000 by default).
PORT=3000
# Public address of the site, used to build the GitHub/Discord callback URLs
# (optional: on Render, RENDER_EXTERNAL_URL is used; otherwise localhost:PORT).
PUBLIC_URL=
# Sign in with GitHub / Discord (optional: a provider without keys is simply
# not offered). See docs/deploiement.md, "Connexion GitHub et Discord".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the guest cookie that recognises a guest across tabs (AUTH-02,
# SALLE-06). Any long random string, e.g. `openssl rand -hex 32` (optional
# locally: without it, a random one is used and guests get a new id after
# every restart).
GUEST_SECRET=
# Password given to the demo accounts made by `bun run db:seed` (optional:
# a random one is printed otherwise).
SEED_PASSWORD=
# Only for scripts/copy-accounts.ts: the database to copy accounts from.
SOURCE_DATABASE_URL=
